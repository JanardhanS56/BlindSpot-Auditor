# =========================================================
# AKILI-SPECS / BlindSpot Auditor Configuration Template
# =========================================================
# Copy this file to .env and insert your API credentials.

# 1. Groq LLM API Key (Get free key at https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here
DEFAULT_MODEL=openai/gpt-oss-120b

# 2. NVIDIA Nemotron Embeddings API Key (Get free key at https://build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# 3. PostgreSQL Database Connection
# You can spin up a pre-configured database in 5 seconds with Docker:
# docker run -d --name blindspot-db -p 5432:5432 -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=postgres ankane/pgvector
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_MAINTAINANCE_DB=postgres
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=postgres

# 4. Pipeline & Optimization Settings (Defaults are pre-configured)
MAX_RETRIES=3
PIPELINE_TIMEOUT=120.0
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.3
EMBEDDING_DIM=4096
EMBEDDING_TRUNCATE=false
